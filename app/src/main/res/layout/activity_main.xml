<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_bg"
        android:contentDescription="Фон" />
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#44000000" />
    <LinearLayout
        android:id="@+id/city_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="140dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_card"
        android:padding="16dp"
        android:elevation="8dp">
        <TextView
            android:id="@+id/city_field"
            android:text="город"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:onClick="setCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/updated_field"
            android:text="время последнего обновления"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
    </LinearLayout>
    <LinearLayout
    android:id="@+id/weather_center_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerInParent="true"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_card"
    android:padding="24dp"
    android:elevation="8dp">
        <ImageView
            android:id="@+id/weather_icon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="Иконка погоды" />
        <TextView
            android:id="@+id/current_temperature_field"
            android:text="0.00 °C"
            android:textColor="#FFFFFF"
            android:textSize="56sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
        <TextView
            android:id="@+id/details_field"
            android:text="Описание\nВлажность\nДавление"
            android:textColor="#E6FFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</RelativeLayout>